# Backend runtime template for localhost and a Node service hosted on a LAMP machine.
PORT=3001
NODE_ENV=development
SYSU_ENV=local
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
AUTH_BACKEND=mysql
TRUST_PROXY=0
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=1200
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sysu_fleet_app
DB_USER=sysu_go_local
DB_PASSWORD=replace-with-runtime-db-password

# API requests share this per-client-IP limit; login and diagnostics also have stricter route limits.
# On a LAMP host, set NODE_ENV=production, exact HTTPS origins, and the verified Apache proxy hop/IP.
# Do not set TRUST_PROXY=true. Leave 0 when accessing the API directly during local development.
# Local npm run dev provisions this limited account through the SYSU App setup hook.
